# Copy to .env.ds41 and edit. This is trusted shell configuration.
# Only the head needs a checkout. Existing passwordless SSH and Docker access
# are prerequisites; the launcher does NOT install keys or configure networking.
WORKER_HOST=user@spark-worker.lan

# EXAMPLES ONLY: substitute the actual preconfigured RoCE addresses/devices.
HEAD_FABRIC_IP=10.100.32.1
WORKER_FABRIC_IP=10.100.32.2
FABRIC_NETWORK=10.100.32.0/23
HEAD_IFNAME=enp1s0f1np1
WORKER_IFNAME=enp1s0f1np1
HEAD_HCA=rocep1s0f1
WORKER_HCA=rocep1s0f1
ROCE_GID_INDEX=3

# Optional second rail. Leave ALL six fields blank for a single-rail setup.
# The published performance/capacity run used two 200-Gbit/s RoCE links.
HEAD_SECONDARY_IP=10.100.33.1
WORKER_SECONDARY_IP=10.100.33.2
HEAD_SECONDARY_IFNAME=enP2p1s0f1np1
WORKER_SECONDARY_IFNAME=enP2p1s0f1np1
HEAD_SECONDARY_HCA=roceP2p1s0f1
WORKER_SECONDARY_HCA=roceP2p1s0f1

# Direct LAN API on the head. No port-forwarding/tunnel is created.
# No authentication is enabled: use only a trusted private network, or bind
# API_HOST to 127.0.0.1 and provide your own authenticated gateway.
API_HOST=0.0.0.0
API_PORT=8888
MASTER_PORT=29541
SERVED_MODEL_NAME=deepseek-v41-flash-exl3

# Tested profile: TP2/DCP2, DSpark K=3, full native vision and tool calling.
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=2048
LONG_PREFILL_TOKEN_THRESHOLD=2048
# Reusable SWA checkpoints inside the same evictable KV pool; 0 restores
# semantic-only retention. Recipe alignment: multiples of 256, up to 1048576.
PREFIX_CACHE_RETENTION_INTERVAL=4096
# Main KV writer: nvfp4_4over6 (default) or legacy; both use display memory.
DS41_FP4_KV_MODE=nvfp4_4over6
# SWA: FP8 scale per 32 or 64 non-RoPE values; RoPE stays BF16 in both modes.
DS41_SWA_KV_GROUP_SIZE=32
# Explicit opt-in to the tested 0.92 startup admission exception. Actual
# profiling/allocation checks and the 512-MiB host watchdog remain enabled.
# Set to 0 if choosing a utilization other than 0.92.
ALLOW_STARTUP_MEMORY_SHORTFALL=1

# Required: both hosts headless, nvidia_drm modeset=1 fbdev=0.
# See docs/display-memory.md. The launcher checks but never changes modules.
HEAD_DRM_CARD=/dev/dri/card0
WORKER_DRM_CARD=/dev/dri/card0
# This pinned runtime uses 1792 MiB display KV/rank and zero ordinary KV.
# Pool size and quantization formats are not arbitrary tunables in this release.

# Storage: default head is this checkout/.assets; default worker is
# the SSH user's ~/.cache/ds41. Override with dedicated ABSOLUTE paths.
# DS41_CACHE_DIR=/mnt/models/ds41
# REMOTE_CACHE_DIR=/mnt/models/ds41
# REMOTE_DIR=/mnt/models/ds41/recipe
# Budget at least 550 GiB free per host for a fresh download/import.
# Public downloads need no HF token. NEVER put HF_TOKEN_WRITE here.
